{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/agendar",
      "destination": "https://calendar.app.google/pQMruvjEWyYwHQ497",
      "permanent": false
    },
    {
      "source": "/agenda",
      "destination": "https://calendar.app.google/pQMruvjEWyYwHQ497",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code([0-9a-f]{14})",
      "destination": "https://n8n.tyve.com.br/webhook/tyve-c?c=:code"
    },
    {
      "source": "/dashboard",
      "destination": "/painel"
    },
    {
      "source": "/config",
      "destination": "/painel"
    },
    {
      "source": "/assinar/plano-:plano",
      "destination": "/assinar?plano=:plano"
    },
    {
      "source": "/privacidade",
      "destination": "/privacy"
    },
    {
      "source": "/conectar-whatsapp",
      "destination": "/embedded-signup"
    },
    {
      "source": "/conectar-instagram",
      "destination": "/instagram-connect"
    },
    {
      "source": "/painel/resultados",
      "destination": "/painel"
    },
    {
      "source": "/painel/configuracoes",
      "destination": "/painel"
    },
    {
      "source": "/painel/:token(street_[A-Za-z0-9]+|[a-z0-9]+_[A-Za-z0-9]{8,})",
      "destination": "/painel?token=:token"
    },
    {
      "source": "/guia-painel",
      "destination": "/guia-painel.pdf"
    },
    {
      "source": "/guia",
      "destination": "/guia.pdf"
    }
  ]
}
